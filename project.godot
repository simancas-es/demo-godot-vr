locale/locale_filter_mode=0

[layer_names]

3d_physics/layer_1="ENV_EYE"
3d_physics/layer_2="ENV_AREA"
3d_physics/layer_3="ROOM"
3d_physics/layer_4="FIXCAM"
3d_physics/layer_5="FALCON"
3d_physics/layer_11="SYSTEMCONCENTRATIONS"
3d_physics/layer_12="SYSTEMPHYSICALCONTROL"
3d_physics/layer_14="WORLD_LADDERS"
3d_physics/layer_15="WORLD_WALLS"
3d_physics/layer_16="WORLD_FLOOR"
3d_physics/layer_17="Held Objects"
3d_physics/layer_18="Player Hand"
3d_physics/layer_19="Grab handles"
3d_physics/layer_20="FPV"
3d_physics/layer_21="Pointable"
3d_physics/layer_22="Hand Pose Area"
3d_physics/layer_23="UI Objects"
3d_physics/layer_24="Static World"
3d_physics/layer_25="Dynamic World"
3d_physics/layer_26="Pickable Objects"
3d_physics/layer_27="Wall Walking Surface"
3d_physics/layer_28="Grappling Target"
3d_physics/layer_29="Player Body"
3d_physics/layer_30="XRDoors"
3d_physics/layer_31="XRDoorsHandle"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/joints/world_node=1
3d/solver/solver_iterations=8
common/enable_pause_aware_picking=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
scaling_3d/mode=1
scaling_3d/fsr_sharpness=0.2

[xr]

openxr/enabled=true
openxr/default_action_map="uid://cv1tl7assnmqv"
openxr/foveation_level=1
openxr/foveation_dynamic=true
shaders/enabled=true
