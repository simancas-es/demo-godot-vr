; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="VirtualTour"
config/version="0.2.2"
run/main_scene="uid://1gnljh2uer8"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0.732139, 0.76047, 0.849627, 1)
config/icon="res://icon.svg"

[autoload]

XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"
ConfigManager="*res://globals/configmanager.gd"
Cache="*res://globals/cache.gd"
AudioManager="*res://globals/audiomanager.gd"
Signals="*res://globals/signalmanager.gd"
InventoryResources="*res://systems/system-inventory/inventory-backend/inventory_resources_autoload.gd"
ControllerManager="*res://globals/controllers/controller_manager.gd"
GameState="*res://globals/gamestate.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1360
window/size/viewport_height=768
window/size/borderless=true

[dotnet]

project/assembly_name="VirtualTour"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/file_dialog_in_editor/plugin.cfg", "res://addons/godot-xr-tools/plugin.cfg")

[global_group]

DIALOG_LOCK=""
SYSTEMSPATIALCONCENTRATION=""

