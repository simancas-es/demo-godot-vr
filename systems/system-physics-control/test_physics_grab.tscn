[sub_resource type="GDScript" id="GDScript_dhqr7"]
script/source = "extends Node3D

@onready var fpv : CharacterBody3D = $CharacterBody3D

func test_settings() -> bool:
	
	
	assert(SYSTEMPHYSICALCONTROLSETTINGS.GRAB_AVAILABLE_ICON is PackedScene)
	assert(SYSTEMPHYSICALCONTROLSETTINGS.GRAB_ACTIVATED_ICON is PackedScene)

	assert(InputMap.has_action(SYSTEMPHYSICALCONTROLSETTINGS.ACTION_GRAB_NAME))
	assert(InputMap.has_action(SYSTEMPHYSICALCONTROLSETTINGS.ACTION_SEND_FURTHER))
	assert(InputMap.has_action(SYSTEMPHYSICALCONTROLSETTINGS.ACTION_SEND_CLOSER))
	
	# Check layer constant validity
	assert(typeof(SYSTEMPHYSICALCONTROLSETTINGS.COLLISION_LAYER) == TYPE_INT)
	# Check mask validity
	assert(typeof(SYSTEMPHYSICALCONTROLSETTINGS.OTHER_COLLISION_LAYER_MASK) == TYPE_INT)

	return true	


func setup_layers() -> bool:	
	var demo_floor : StaticBody3D = %Floor
	demo_floor.set_collision_layer_value(SYSTEMPHYSICALCONTROLUTILS.log2_int(SYSTEMPHYSICALCONTROLSETTINGS.LAYER_FLOOR) + 1, true)
	demo_floor.set_collision_mask_value(SYSTEMPHYSICALCONTROLUTILS.log2_int(SYSTEMPHYSICALCONTROLSETTINGS.LAYER_WALLS) + 1, true)
	
	var demo_door : SystemPhysicalControlObject = %door
	demo_door.set_collision_layer_value(SYSTEMPHYSICALCONTROLUTILS.log2_int(SYSTEMPHYSICALCONTROLSETTINGS.LAYER_WALLS) + 1, true)
	demo_door.set_collision_mask_value(SYSTEMPHYSICALCONTROLUTILS.log2_int(SYSTEMPHYSICALCONTROLSETTINGS.LAYER_FPVPLAYER) + 1, true)
	return true

	
func _ready() -> void:
	assert (setup_layers())
	assert (test_settings())
	print(\"SYSTEMPHYSICALCONTROL module seems to work.\")
	pass
"

